#!/usr/bin/env python
#
# Make APOGEE daily plan files for a single MJD

import traceback
import os
import sys
import shlex
from argparse import ArgumentParser
import datetime
import time
from dlnpyutils import utils as dln
from apogee_drp.plan import mkplan
from apogee_drp.plan import apogeedrp
from apogee_drp.utils import apload

# Main command-line program
if __name__ == "__main__":
    # print out what was executed for the logfile
    print(shlex.join([sys.executable, *sys.argv]))
    parser = ArgumentParser(description='Make APOGEE plan files')
    parser.add_argument('mjd', type=int, nargs=1, help='MJD to run')
    parser.add_argument('apred', type=str, nargs=1, help='APOGEE Reduction version')
    parser.add_argument('telescope', type=str, nargs=1, help='Telescope')
    parser.add_argument('--pbskey', type=str, nargs=1, default='', help='Slurm key')
    parser.add_argument('--clobber', action='store_true', help='Overwrite any existing files')
    parser.add_argument('--verbose', action='store_true', help='Verbose output')
    args = parser.parse_args()

    mjd = args.mjd[0]
    apred = args.apred[0]
    telescope = args.telescope[0]
    clobber = args.clobber
    verbose = args.verbose
    pbskey = args.pbskey
    if isinstance(pbskey,list):
        pbskey = pbskey[0]
    
    logger = dln.basiclogger()
    
    now = datetime.datetime.now()
    start = time.time()
    logger.info("Start: "+now.strftime("%Y-%m-%d %H:%M:%S"))

    # Reduction logs directory
    observatory = telescope[:3]
    plansdir = os.environ['APOGEE_REDUX']+'/'+apred+'/log/'+observatory+'/plans/'
    os.makedirs(plansdir,exist_ok=True)
    
    logger.info(' ')
    logger.info('Making plan files for MJD='+str(mjd))

    # Make the MJD5 file
    plandicts,planfiles0 = mkplan.make_mjd5_yaml(mjd,apred,telescope,clobber=clobber,logger=logger)
    mjd5planfile = os.environ['APOGEEREDUCEPLAN_DIR']+'/yaml/'+apred+'/'+telescope+'/'+telescope+'_'+str(mjd)+'.yaml'

    # Make the individual plan files
    error = []
    if os.path.exists(mjd5planfile):
        try:
            planfiles = mkplan.run_mjd5_yaml(mjd5planfile,clobber=clobber,logger=logger)
            nplanfiles = len(planfiles)
        except:
            logger.exception('Error making plan files')
            e = traceback.format_exc()
            logger.info(e)
            error.append(e)
            # use the initial list of plan files
            planfiles = planfiles0.copy()
            nplanfiles = len(planfiles)
            
        logger.info('Writing list of plan files to '+plansdir+str(mjd)+'.plans')
        if nplanfiles>0:
            apogeedrp.dbload_plans(planfiles,pbskey)  # load plans into db
            # Write planfiles to MJD5.plans
            #dln.writelines(plansdir+str(mjd)+'.plans',[os.path.basename(pf) for pf in planfiles])
            dln.writelines(plansdir+str(mjd)+'.plans',planfiles)
        else:
            dln.writelines(plansdir+str(mjd)+'.plans','')   # write blank file                                

    else:
        logger.info(mjd5planfile+' NOT FOUND')

    # Run the check
    load = apload.ApLoad(apred=apred,telescope=telescope)
    chkplan = apogeedrp.check_plan([mjd],load,pbskey,dbload=False,verbose=True,logger=logger)
        
    now = datetime.datetime.now()
    logger.info("End: "+now.strftime("%Y-%m-%d %H:%M:%S"))
    logger.info("elapsed: {:.2f} sec".format(time.time()-start))
